<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="npc-gui"
        Arguments=""
        InstallLocation="C:\Program Files\NPS\NPS Client">
    </Installer>
    <PackageInformation
        PackageName="NPS Client"
        PackageDisplayName="NPS Client"
        PublisherName="CN=NPS"
        PublisherDisplayName="NPS"
        Version="0.26.40.0"
        PackageDescription="NPS 客户端">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.nps.client"
                Description="NPS 客户端"
                DisplayName="NPS Client"
                ExecutableName="npc-gui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NPS Client</DisplayName>
            <PublisherDisplayName>NPS</PublisherDisplayName>
            <Description>NPS 客户端</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="npc-gui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
